# DO NOT ADD ANY REAL API KEYS HERE!!!
# This is a template for the .env file to show what API keys are needed!
# Create your own file for environment variables by declaring '.env' on the same directory level as this example file
# Get environment variables from the notion or from a project lead
POSTGRES_URL=""
DATABASE_URL=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL=""

# Database driver: "neon" (default) or "local" (postgres-js against the docker/ compose DB)
DB_PROVIDER="local"
# Use 127.0.0.1, not "localhost": with Docker Desktop on Windows, "localhost" can
# resolve to IPv6 (::1) and time out. The browser is fine with either.
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5432/ieee-website"
POSTGRES_URL="postgres://postgres:postgres@127.0.0.1:5432/ieee-website"

# ---- Media storage ----
# "local" = S3-compatible endpoint (MinIO in docker/ compose); "vercel" = Vercel Blob
STORAGE_PROVIDER="local"
# Client needs to know the provider too (must match STORAGE_PROVIDER)
NEXT_PUBLIC_STORAGE_PROVIDER="local"

# local / MinIO (STORAGE_PROVIDER=local)
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET_PUBLIC="media-public"
S3_BUCKET_PRIVATE="resumes-private"
# Public (browser-facing) URL for photos — "localhost" is fine here
S3_PUBLIC_BASE_URL="http://localhost:9000/media-public"

# Vercel Blob (STORAGE_PROVIDER=vercel) — set only on preview / production.
# Connecting a Blob store to the Vercel project auto-adds BLOB_READ_WRITE_TOKEN
# (plus BLOB_STORE_ID / BLOB_WEBHOOK_PUBLIC_KEY, which this app does not read directly).
# That single token is all you need today (one private store holds all media).
BLOB_READ_WRITE_TOKEN=""
# Optional overrides, only for a future two-store (public feed) setup:
# BLOB_RW_TOKEN_PRIVATE=""
# BLOB_RW_TOKEN_PUBLIC=""
BLOB_WEBHOOK_PUBLIC_KEY=""
BLOB_STORE_ID=""

# Résumé-upload rollout gate: "admins" | "officers" | "members".
#   Phase 2 (pilot): set to "officers" and grant the `upload_resume` capability to a
#     pilot cohort on /admin/members — those members can upload regardless of this value.
#   Phase 3 (GA): flip to "members" — every member gets the résumé field in /settings.
RESUME_UPLOAD_AUDIENCE="officers"
